{
  "name": "poke-tcg-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Static site for a personal Pok\u00e9mon card collection: portfolio, card database, set tracker and wishlist.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "clean": "rm -rf dist",
    "prices": "node scripts/fetch-prices.mjs",
    "prices:write": "node scripts/fetch-prices.mjs --write && node scripts/check-prices.mjs",
    "images:need": "node scripts/fetch-missing-images.mjs --write",
    "check": "node scripts/check-prices.mjs",
    "sprites": "node scripts/fetch-sprites.mjs",
    "sprites:write": "node scripts/fetch-sprites.mjs --write"
  },
  "engines": {
    "node": ">=18"
  }
}
