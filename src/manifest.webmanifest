{
  "name": "Poké TCG Tracker",
  "short_name": "Poké TCG",
  "description": "A personal Pokémon card collection: portfolio, cards, sealed product, set completion and wishlist.",
  "start_url": "index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f1ebfd",
